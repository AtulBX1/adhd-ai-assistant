# ─────────────────────────────────────────────────────
# ADHD AI Assistant — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────

# ── Groq API (required) ───────────────────────────────
# Get your free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── CORS (required in production) ────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://adhd-assistant-frontend.onrender.com
# Use * only for local testing — never in production.
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:3000

# ── Server (optional — Render sets PORT automatically) ─
# Default: 5000 for local dev; Render injects its own PORT
PORT=5000

# ── Flask (optional) ──────────────────────────────────
FLASK_ENV=production
